
# Environment files
.env
.env.*
!.env.example
!.env.testing

# Local database and runtime files
/database/*.sqlite
/database/*.sqlite-journal

# Dependency / build output
/vendor/
/node_modules/
/public/build/
/public/hot

# Test / cache output
.phpunit.result.cache
phpunit.result.cache
npm-debug.log*

# OS/editor artifacts
.DS_Store
Thumbs.db

# IMPORTANT: uploaded CRUD files and runtime storage data must stay on server
# and MUST NOT be managed by Git.
/storage/*
!/storage/.gitignore
!/storage/app/
!/storage/app/public/
!/storage/framework/
!/storage/logs/
!/storage/medicines/
!/storage/banners/
!/storage/promos/
!/storage/principellogos/
!/storage/news/

# Keep placeholder files only; actual uploaded files stay local/server-only
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public/.gitignore
/storage/framework/*
!/storage/framework/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/storage/medicines/*
!/storage/medicines/.gitignore
/storage/banners/*
!/storage/banners/.gitignore
/storage/promos/*
!/storage/promos/.gitignore
/storage/principellogos/*
!/storage/principellogos/.gitignore
/storage/news/*
!/storage/news/.gitignore

# Keep Laravel cache/session folders but not generated runtime data files
!/storage/framework/cache/
!/storage/framework/sessions/
!/storage/framework/views/
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore